# OKX API credentials — скопируйте в .env и заполните своими значениями.
# .env в .gitignore — НЕ коммитить. Никогда не вставляйте сюда боевые ключи в чат/репозиторий.

# Demo-ключ (создаётся: OKX → Demo Trading → Personal Center → Demo Trading API)
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=

# Live-ключ (Фаза 4+). Права: Read + Trade. БЕЗ Withdraw. С IP-whitelist.
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# Регион: www.okx.com (global) | eea.okx.com | app.okx.com (us)
OKX_DOMAIN=www.okx.com

# Режим по умолчанию: demo | live
OKX_MODE=demo
