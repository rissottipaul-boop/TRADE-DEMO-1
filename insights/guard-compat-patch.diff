+
+
 def check_command(cmd: str, policy: dict, okx_profiles) -> Optional[str]:
     low = cmd.lower().replace("\\", "/")
+    for root_form in _ROOT_FORMS:
+        low = low.replace(root_form, "")
     for pattern, reason in DENY_COMMAND_RULES:
         if pattern.search(low):
             return reason
