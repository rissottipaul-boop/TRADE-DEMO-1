+_ROOT_WIN = str(ROOT).replace("\\", "/").lower().rstrip("/") + "/"
+_ROOT_FORMS = tuple(dict.fromkeys([re.sub(r"^([a-z]):", r"/mnt/\1", _ROOT_WIN), _ROOT_WIN,
